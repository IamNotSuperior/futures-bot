# Secrets — never commit
.env
.env.*
!.env.example

# Virtual environment
venv/

# Market data — large, regenerable, and not source.
# The directory itself is tracked (via .gitkeep) so a fresh clone keeps the
# documented project structure, and Python source under data/ is tracked
# because it is code, not data. Everything else inside data/ is ignored.
data/*
!data/.gitkeep
!data/*.py

# Generated backtest output - regenerable from the code and cached bars
backtests/results/*
!backtests/results/.gitkeep

# Python bytecode
__pycache__/

# Parquet data files (anywhere in the tree)
*.parquet

# The journal is TRACKED on purpose. Committing each close puts the record in
# git history, where an after-the-fact edit shows up as a rewrite rather than
# passing unnoticed. That tamper-evidence is the point of the file.

# Desk bot runtime files. `journal/trades.jsonl` is tracked because it is the
# evidence for hypothesis entry 3; these two are not evidence and must not be
# mistakable for it.
#   desk_state.json      - runtime state, rewritten on every bar
#   shadow_trades.jsonl  - plumbing-test output from a REJECTED strategy,
#                          regenerable with `desk.py --replay`
journal/desk_state.json
journal/shadow_trades.jsonl
#   tunnel.log           - cloudflared output, may contain the public hostname
journal/tunnel.log

# Live-bar mirror written by the desk for the research bot's /read.
# Regenerated every session; the parquet cache is the durable copy.
journal/live_bars/

# Generated strategy artefacts. The .py files ARE tracked - an approved
# strategy is frozen in a commit and must be reviewable - but their run
# outputs are not.
strategies/generated/__pycache__/
tests/generated/__pycache__/
