# Secrets — never commit
.env
.env.*
!.env.example

# Virtual environment
venv/

# Market data — large, regenerable, and not source.
# The directory itself is tracked (via .gitkeep) so a fresh clone keeps the
# documented project structure, and Python source under data/ is tracked
# because it is code, not data. Everything else inside data/ is ignored.
data/*
!data/.gitkeep
!data/*.py

# Generated backtest output - regenerable from the code and cached bars
backtests/results/*
!backtests/results/.gitkeep

# Python bytecode
__pycache__/

# Parquet data files (anywhere in the tree)
*.parquet

# The journal is TRACKED on purpose. Committing each close puts the record in
# git history, where an after-the-fact edit shows up as a rewrite rather than
# passing unnoticed. That tamper-evidence is the point of the file.
