# Copy this file to .env and fill in real values. .env is gitignored.
DATABENTO_API_KEY=
DISCORD_TOKEN=

# --- desk bot (bots/desk.py) ------------------------------------------------
# Channel the desk posts tickets and blocks to. Required for Discord output;
# without it the desk still runs and prints to stdout.
DESK_TICKET_CHANNEL_ID=
# Heartbeats, the 09:25 pre-market check and reconciliation warnings. Falls
# back to DESK_TICKET_CHANNEL_ID when empty.
DESK_OPS_CHANNEL_ID=
# The 16:35 daily summary. Falls back to DESK_TICKET_CHANNEL_ID when empty.
DESK_SUMMARY_CHANNEL_ID=
# Shared secret for the bar webhook. REQUIRED once a tunnel is running: it is
# the only thing in front of the feed. bots/tunnel.py refuses to start without
# one. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# Append ?token=<value> to the TradingView webhook URL - TradingView cannot
# send custom headers, so it has to travel in the query string.
DESK_WEBHOOK_TOKEN=

# Stable hostname for a Cloudflare NAMED tunnel, e.g. desk.example.com.
# Requires a Cloudflare account and a domain whose DNS is on Cloudflare, set up
# once with `cloudflared tunnel login`, `tunnel create` and `tunnel route dns`.
# Leave EMPTY to use a quick tunnel instead - no account needed, but it gets a
# new random *.trycloudflare.com hostname on every restart, which silently
# orphans any TradingView alert pointing at the old one.
DESK_TUNNEL_HOSTNAME=
