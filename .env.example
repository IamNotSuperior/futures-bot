# Copy this file to .env and fill in real values. .env is gitignored.
DATABENTO_API_KEY=
DISCORD_TOKEN=

# --- desk bot (bots/desk.py) ------------------------------------------------
# The text channel EVERY desk post goes to - tickets, blocks, the 09:25
# pre-market check, heartbeats, the 16:35 summary, reconnect notices. Resolved
# by NAME in the bot's guild at startup. If it cannot be found or posted to,
# the desk exits with a clear error rather than falling back to stdout.
DESK_CHANNEL_NAME=general
# Your Discord user id. Only this user may press a ticket's Execute / Don't
# trade buttons; anyone else gets an ephemeral refusal. Get it with Discord's
# Developer Mode (User Settings > Advanced > Developer Mode), then right-click
# your own name > Copy User ID. It is an 17-19 digit number, not your name.
DESK_OWNER_ID=
# Shared secret for the bar webhook. REQUIRED once a tunnel is running: it is
# the only thing in front of the feed. bots/tunnel.py refuses to start without
# one. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# Append ?token=<value> to the TradingView webhook URL - TradingView cannot
# send custom headers, so it has to travel in the query string.
DESK_WEBHOOK_TOKEN=

# Stable hostname for a Cloudflare NAMED tunnel, e.g. desk.example.com.
# Requires a Cloudflare account and a domain whose DNS is on Cloudflare, set up
# once with `cloudflared tunnel login`, `tunnel create` and `tunnel route dns`.
# Leave EMPTY to use a quick tunnel instead - no account needed, but it gets a
# new random *.trycloudflare.com hostname on every restart, which silently
# orphans any TradingView alert pointing at the old one.
DESK_TUNNEL_HOSTNAME=
